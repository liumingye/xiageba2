generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id            String         @id @default(cuid(2)) @db.VarChar(32)
  username      String         @unique @db.VarChar(50)
  password      String         @db.VarChar(255)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime?      @updatedAt @db.Timestamptz(3)
}

model Feedback {
  id            String         @id @default(cuid(2))
  musicId       String
  musicTitle    String
  musicArtist   String
  type          FeedbackType
  description   String         @default("")
  email         String         @default("")
  status        FeedbackStatus @default(PENDING)
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime?      @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([musicId])
  @@index([status])
}

model Music {
  id           String                   @id @default(cuid(2)) @db.VarChar(32)
  title        String                   @db.VarChar(255)
  artist       String                   @db.VarChar(255)
  album        String                   @db.VarChar(255)
  cover        String                   @db.VarChar(2048)
  lyrics       String?                  @db.Text
  playUrl      String                   @db.VarChar(2048)
  downloads    Json                     @default("[]")
  viewCount    Int                      @default(0)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime?                @updatedAt @db.Timestamptz(3)
  searchVector Unsupported("tsvector")?

  @@index([createdAt])
  @@index([viewCount])
  @@index([searchVector], type: Gin)
}

model Category {
  id           Int              @id @default(autoincrement())
  name         String           @db.VarChar(255)
  image        String           @default("") @db.VarChar(2048)
  sort         Int              @default(0) @db.SmallInt
  isShow       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime?        @updatedAt @db.Timestamptz(3)

  @@index([sort])
}

model Source {
  id            String      @id @default(cuid(2)) @db.VarChar(32)
  cid           Int?        @db.SmallInt
  title         String
  url           String
  description   String      @default("")
  menu          String      @default("")
  status        Int         @default(1) @db.SmallInt
  invalidNum    Int         @default(0) @db.SmallInt
  isSelf        Boolean     @default(false)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime?   @updatedAt @db.Timestamptz(3)

  searchVector  Unsupported("tsvector")?

  @@index([cid])
  @@index([cid, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model SourceTemp {
  id        Int       @id @default(autoincrement())
  url       String
  fid       String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

model Config {
  key   String @id
  value String @default("")
}

model ApiList {
  id           String      @id @default(cuid(2))
  name         String
  type         String      @default("api")
  url          String
  method       String      @default("GET")
  headers      String      @default("{}")
  fixed_params String      @default("{}")
  field_map    String      @default("{}")
  count        Int         @default(10)
  html_item    String      @default("")
  html_title   String      @default("")
  html_url     Int         @default(0)
  html_type    String      @default("")
  html_url2    String      @default("")
  weight       Int         @default(0)
  status       Int         @default(1)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime?   @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([weight])
}

model Announcement {
  id          String              @id @default(cuid(2)) @db.VarChar(32)
  title       String              @db.VarChar(255)
  content     String              @default("") @db.Text
  displayType AnnouncementDisplay @default(NORMAL)
  icon        AnnouncementIcon    @default(INFO)
  status      AnnouncementStatus  @default(ACTIVE)
  sort        Int                 @default(0) @db.SmallInt
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime?           @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([displayType])
  @@index([sort])
  @@index([createdAt])
}

enum AnnouncementDisplay {
  NORMAL
  BANNER
  DIALOG
}

enum AnnouncementIcon {
  INFO
  WARN
  ERROR
  SUCCESS
}

enum AnnouncementStatus {
  ACTIVE
  ARCHIVED
}

model S3Config {
  id         Int           @id @default(autoincrement())
  name       String        @db.VarChar(100)
  baseUrl    String        @default("") @db.VarChar(2048)
  bucket     String        @db.VarChar(255)
  prefix     String        @default("") @db.VarChar(255)
  endpoint   String        @default("") @db.VarChar(2048)
  region     String        @default("") @db.VarChar(100)
  accessKey  String        @db.VarChar(255)
  secretKey  String        @db.VarChar(255)
  isHidden   Boolean       @default(false)
  files      StorageFile[]
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime?     @updatedAt @db.Timestamptz(3)

  @@index([isHidden])
}

model StorageFile {
  id         String    @id @default(cuid(2)) @db.VarChar(32)
  configId   Int
  config     S3Config  @relation(fields: [configId], references: [id], onDelete: Cascade)
  path       String    @db.VarChar(2048)
  name       String    @db.VarChar(255)
  size       Int       @default(0)
  mimeType   String    @default("") @db.VarChar(100)
  url        String    @db.VarChar(2048)
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @db.Timestamptz(3)

  @@index([configId])
  @@index([path])
  @@index([name])
  @@index([isDeleted])
  @@index([createdAt])
}

enum FeedbackStatus {
  PENDING
  DONE
}

enum FeedbackType {
  BROKEN_LINK
  WRONG_CONTENT
  WRONG_CODE
  WRONG_QUALITY
  WRONG_INFO
}
