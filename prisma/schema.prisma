generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  engineType    = "client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator sql {
  provider = "prisma-sql-generator"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String    @id @default(cuid(2)) @db.VarChar(32)
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
}

model Feedback {
  id          String         @id @default(cuid(2))
  musicId     String
  musicTitle  String
  musicArtist String
  type        FeedbackType
  description String         @default("")
  email       String         @default("")
  status      FeedbackStatus @default(PENDING)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime?      @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([musicId])
  @@index([status])
}

model Music {
  id           String                   @id @default(cuid(2)) @db.VarChar(32)
  title        String                   @db.VarChar(255)
  artist       String                   @db.VarChar(255)
  album        String                   @db.VarChar(255)
  cover        String                   @db.VarChar(2048)
  lyrics       String?                  @db.Text
  playUrl      String                   @db.VarChar(2048)
  downloads    Json                     @default("[]")
  viewCount    Int                      @default(0)
  status       Int                      @default(1) @db.SmallInt // 1=启用 0=停用
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime?                @updatedAt @db.Timestamptz(3)
  searchVector Unsupported("tsvector")?

  @@index([viewCount])
  @@index([status])
  @@index([searchVector], type: Gin)
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  image     String    @default("") @db.VarChar(2048)
  sort      Int       @default(0) @db.SmallInt
  isShow    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@index([sort])
}

model Source {
  id          String    @id @default(cuid(2)) @db.VarChar(32)
  cid         Int?      @db.SmallInt
  title       String
  url         String
  description String    @default("")
  menu        String    @default("")
  status      Int       @default(1) @db.SmallInt
  invalidNum  Int       @default(0) @db.SmallInt
  isSelf      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime? @updatedAt @db.Timestamptz(3)

  searchVector Unsupported("tsvector")?

  @@index([cid])
  @@index([cid, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model SourceTemp {
  id        Int      @id @default(autoincrement())
  url       String
  fid       String?
  accountId Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([accountId])
}

/// 网盘账号表（多账号）
model PanAccount {
  id           Int       @id @default(autoincrement())
  type         String    @db.VarChar(20) // quark | baidu | uc | xunlei
  name         String    @default("") @db.VarChar(100) // 网盘账号昵称
  cookie       String    @default("") @db.Text
  refreshToken String    @default("") @db.Text
  accessToken  String    @default("") @db.Text
  expiresAt    DateTime? @db.Timestamptz(3)
  tempDir      String    @default("") @db.VarChar(255)
  status       Int       @default(1) @db.SmallInt // 1=启用 0=停用
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime? @updatedAt @db.Timestamptz(3)

  @@index([type])
  @@index([status])
}

model Config {
  key   String @id
  value String @default("")
}

/// 自定义页面表（后台「页面管理」）
model Page {
  id        String     @id @default(cuid(2)) @db.VarChar(32)
  slug      String     @unique @db.VarChar(100)
  title     String     @db.VarChar(255)
  content   String     @default("") @db.Text
  icon      String     @default("file-text") @db.VarChar(50)
  status    PageStatus @default(PUBLISHED)
  sort      Int        @default(0) @db.SmallInt
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime?  @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([sort])
  @@index([createdAt])
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model ApiList {
  id           String    @id @default(cuid(2))
  name         String
  type         String    @default("api")
  url          String
  method       String    @default("GET")
  headers      String    @default("{}")
  fixed_params String    @default("{}")
  field_map    String    @default("{}")
  count        Int       @default(10)
  html_item    String    @default("")
  html_title   String    @default("")
  html_url     Int       @default(0)
  html_type    String    @default("")
  html_url2    String    @default("")
  weight       Int       @default(0)
  status       Int       @default(1)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime? @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([weight])
}

model Announcement {
  id          String              @id @default(cuid(2)) @db.VarChar(32)
  title       String              @db.VarChar(255)
  content     String              @default("") @db.Text
  displayType AnnouncementDisplay @default(NORMAL)
  icon        AnnouncementIcon    @default(INFO)
  status      AnnouncementStatus  @default(ACTIVE)
  sort        Int                 @default(0) @db.SmallInt
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime?           @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([displayType])
  @@index([sort])
  @@index([createdAt])
}

enum AnnouncementDisplay {
  NORMAL
  BANNER
  DIALOG
}

enum AnnouncementIcon {
  INFO
  WARN
  ERROR
  SUCCESS
}

enum AnnouncementStatus {
  ACTIVE
  ARCHIVED
}

model S3Config {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(100)
  baseUrl   String        @default("") @db.VarChar(2048)
  bucket    String        @db.VarChar(255)
  prefix    String        @default("") @db.VarChar(255)
  endpoint  String        @default("") @db.VarChar(2048)
  region    String        @default("") @db.VarChar(100)
  accessKey String        @db.VarChar(255)
  secretKey String        @db.VarChar(255)
  isHidden  Boolean       @default(false)
  files     StorageFile[]
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime?     @updatedAt @db.Timestamptz(3)

  @@index([isHidden])
}

// ⚠️ (configId, path) 的活跃唯一约束是**部分唯一索引**
// （WHERE "isDeleted" = false，见 migration 20261027232000_add_storage_file_active_path_unique）。
// Prisma schema 表达不了部分索引，所以这里看不到对应声明 —— 这不是漏了。
// 千万不要改成 @@unique([configId, path])：完整唯一约束会把已软删除的行也算进去，
// 导致删掉文件后无法再上传同名文件；同时也别手工删掉数据库里那个索引，
// 它是多进程/多副本部署下唯一能拦住"两条记录指向同一个对象"的防线。
model StorageFile {
  id        String    @id @default(cuid(2)) @db.VarChar(32)
  configId  Int
  config    S3Config  @relation(fields: [configId], references: [id], onDelete: Cascade)
  path      String    @db.VarChar(2048)
  name      String    @db.VarChar(255)
  size      Int       @default(0)
  mimeType  String    @default("") @db.VarChar(100)
  url       String    @db.VarChar(2048)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  @@index([configId])
  @@index([path])
  @@index([name])
  @@index([isDeleted])
  @@index([createdAt])
}

enum FeedbackStatus {
  PENDING
  DONE
}

enum FeedbackType {
  BROKEN_LINK
  WRONG_CONTENT
  WRONG_CODE
  WRONG_QUALITY
  WRONG_INFO
}
